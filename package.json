{
	"name": "@licenseman/tauri",
	"version": "0.0.0",
	"description": "Tauri SDK for licensemanager.dev (JS bindings of tauri-plugin-licensemanager)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/licenseman/licensemanager-tauri.git"
	},
	"homepage": "https://licensemanager.dev/docs/tauri",
	"bugs": {
		"url": "https://github.com/licenseman/licensemanager-tauri/issues"
	},
	"type": "module",
	"main": "./dist-js/index.cjs",
	"module": "./dist-js/index.js",
	"types": "./dist-js/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist-js/index.d.ts",
				"default": "./dist-js/index.js"
			},
			"require": {
				"types": "./dist-js/index.d.cts",
				"default": "./dist-js/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist-js"
	],
	"sideEffects": false,
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-versions.mjs",
		"release": "pnpm build && node scripts/publish.mjs && changeset publish",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@tauri-apps/api": "^2.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"tauri",
		"tauri-plugin",
		"license",
		"licensing",
		"licensemanager",
		"sdk"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@tauri-apps/api": "^2.12.4",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"jsdom": "^30.1.3",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
